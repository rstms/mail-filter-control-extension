{
  "manifest_version": 3,
  "version": "1.5.13",
  "author": "Matt Krueger <mkrueger@rstms.net>",
  "homepage_url": "https://github.com/rstms/mail-filter-control-extension",
  "name": "Mail Filter Control",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-filter-control-69bc8149-6b01-4c11-b35f-6d43b7f9f0d3@rstms.net",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/rstms/mail-filter-control-extension/releases/latest/download/updates.json"
    }
  },
  "options_ui": {
    "page": "./options.html"
  },
  "background": {
    "scripts": [
      "./src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Mail Filter",
    "default_icon": "funnel.svg",
    "type": "button",
    "allowed_spaces": [
      "mail"
    ]
  },
  "message_display_action": {
    "default_title": "Add Sender to Filter Book",
    "default_icon": "funnel.svg",
    "type": "button"
  },
  "host_permissions": [
    "https://webmail.mailcapsule.io/mailfilter/*",
    "https://webmail.rstms.net/mailfilter/*",
    "https://webmail.komicollc.com/mailfilter/*",
    "https://webmail.cypress-trading.com/mailfilter/*",
    "https://webmail.greenbluffllc.com/mailfilter/*",
    "https://webmail.harborstreetventures.com/mailfilter/*",
    "https://webmail.citybestmanagement.com/mailfilter/*"
  ],
  "permissions": [
    "addressBooks",
    "accountsRead",
    "accountsFolders",
    "compose",
    "compose.send",
    "menus",
    "messagesDelete",
    "messagesRead",
    "messagesMove",
    "storage",
    "tabs"
  ],
  "commands": {
    "mailfilter-add-sender-address-whitelist": {
      "suggested_key": {
        "default": "Ctrl+W"
      },
      "description": "Add message sender address to whitelist"
    },
    "mailfilter-add-sender-domain-whitelist": {
      "suggested_key": {
        "default": "Ctrl+Shift+W"
      },
      "description": "Add message sender domain to whitelist"
    },
    "mailfilter-add-sender-address-default": {
      "suggested_key": {
        "default": "Ctrl+B"
      },
      "description": "Add message sender address to default filter book"
    },
    "mailfilter-add-sender-domain-default": {
      "suggested_key": {
        "default": "Ctrl+Shift+B"
      },
      "description": "Add message sender domain to default filter book"
    },
    "mailfilter-add-sender-address-1": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "Add message sender address to filter book 1"
    },
    "mailfilter-add-sender-address-2": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "Add message sender address to filter book 2"
    },
    "mailfilter-add-sender-address-3": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "Add message sender address to filter book 3"
    },
    "mailfilter-add-sender-address-4": {
      "suggested_key": {
        "default": "Alt+4"
      },
      "description": "Add message sender address to filter book 4"
    },
    "mailfilter-add-sender-address-5": {
      "suggested_key": {
        "default": "Alt+5"
      },
      "description": "Add message sender address to filter book 5"
    },
    "mailfilter-add-sender-address-6": {
      "suggested_key": {
        "default": "Alt+6"
      },
      "description": "Add message sender address to filter book 6"
    },
    "mailfilter-add-sender-domain-1": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Add message sender domain to filter book 1"
    },
    "mailfilter-add-sender-domain-2": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Add message sender domain to filter book 2"
    },
    "mailfilter-add-sender-domain-3": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Add message sender domain to filter book 3"
    },
    "mailfilter-add-sender-domain-4": {
      "suggested_key": {
        "default": "Alt+Shift+4"
      },
      "description": "Add message sender domain to filter book 4"
    },
    "mailfilter-add-sender-domain-5": {
      "suggested_key": {
        "default": "Alt+Shift+5"
      },
      "description": "Add message sender domain to filter book 5"
    },
    "mailfilter-add-sender-domain-6": {
      "suggested_key": {
        "default": "Alt+Shift+6"
      },
      "description": "Add message sender domain to filter book 6"
    }
  },
  "experiment_apis": {
    "cardDAV": {
      "schema": "./experiments/carddav/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "cardDAV"
          ]
        ],
        "script": "./experiments/carddav/carddav.js"
      }
    },
    "accountDetail": {
      "schema": "./experiments/accountDetail/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "accountDetail"
          ]
        ],
        "script": "./experiments/accountDetail/account_detail.js"
      }
    },
    "activityManager": {
      "schema": "./experiments/activity_manager/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "activityManager"
          ]
        ],
        "script": "./experiments/activity_manager/activity_manager.js"
      }
    },
    "backgroundSend": {
      "schema": "./experiments/background_send/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "backgroundSend"
          ]
        ],
        "script": "./experiments/background_send/background_send.js"
      }
    },
    "servicesPrompt": {
      "schema": "./experiments/services_prompt/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "servicesPrompt"
          ]
        ],
        "script": "./experiments/services_prompt/services_prompt.js"
      }
    }
  }
}
